# Copia este fichero como .env y rellénalo con los datos de TU cuenta de Zotero.
# El .env está en .gitignore: nunca se sube a GitHub. No pongas datos reales aquí.
#
# Ambos datos están en https://www.zotero.org/settings/keys

# «Your user ID for use in API calls is ...» (un número, no tu nombre de usuario).
# Para un grupo, el número de https://www.zotero.org/groups/<número>/...
ZOTERO_LIBRARY_ID=

# Clave creada con «Create new private key» y «Allow library access» (solo lectura basta).
ZOTERO_API_KEY=

# «user» para tu biblioteca personal, «group» para un grupo.
ZOTERO_LIBRARY_TYPE=user
